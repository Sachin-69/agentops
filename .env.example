# =========================================================
# Chat Support Agent - Environment Configuration
# Copy this file to `.env` and fill in the values you need.
# The app runs out-of-the-box with LLM_PROVIDER=none.
# =========================================================

# LLM provider: none | openai | anthropic | ollama
# - none      -> extractive answers built from retrieved docs (no API key needed)
# - openai    -> requires OPENAI_API_KEY, pip install openai
# - anthropic -> requires ANTHROPIC_API_KEY, pip install anthropic
# - ollama    -> local Ollama server (default http://localhost:11434)
LLM_PROVIDER=none

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20240620

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1

# --- Retrieval settings ---
DOCS_DIR=docs
TOP_K=4
# Minimum similarity (0-1) for a chunk to be considered relevant.
# If no chunk clears this bar, the agent refuses to answer.
MIN_RELEVANCE=0.12
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Message shown when the question is out of scope of the docs.
REFUSAL_MESSAGE=I'm sorry, but I can only answer questions based on the provided support documentation, and I couldn't find anything relevant to your question. Please rephrase or contact a human support agent.
